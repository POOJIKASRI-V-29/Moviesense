# Copy to .env and adjust. No secrets are required by MovieSense.
# Classifier: baseline (TF-IDF + LogReg) or distilbert (after installing Colab artefacts)
MOVIESENSE_MODEL=baseline
# Retrieval encoder: tfidf or distilbert
MOVIESENSE_RETRIEVAL=tfidf
MOVIESENSE_HOST=127.0.0.1
MOVIESENSE_PORT=8000
# Comma-separated origins allowed by CORS (the Vite dev server by default)
MOVIESENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MOVIESENSE_RATE_LIMIT_PER_MINUTE=60
MOVIESENSE_LOG_LEVEL=INFO
